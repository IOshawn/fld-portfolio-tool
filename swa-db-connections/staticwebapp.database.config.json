{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DATABASE_CONNECTION_STRING')",
    "options": { "set-session-context": false }
  },
  "runtime": {
    "rest": { "enabled": true, "path": "/rest" },
    "graphql": { "enabled": false },
    "host": {
      "mode": "production",
      "authentication": { "provider": "StaticWebApps" }
    }
  },
  "entities": {
    "Project": {
      "source": "phub.Projects",
      "rest": { "path": "/Projects" },
      "permissions": [{ "role": "authenticated", "actions": ["read", "create", "update"] }]
    },
    "Milestone": {
      "source": "phub.Milestones",
      "rest": { "path": "/Milestones" },
      "permissions": [{ "role": "authenticated", "actions": ["read", "create", "update"] }]
    },
    "Engagement": {
      "source": "phub.Engagements",
      "rest": { "path": "/Engagements" },
      "permissions": [{ "role": "authenticated", "actions": ["read", "create", "update"] }]
    },
    "Update": {
      "source": "phub.Updates",
      "rest": { "path": "/Updates" },
      "permissions": [{ "role": "authenticated", "actions": ["read", "create", "update"] }]
    }
  }
}
